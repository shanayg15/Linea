PORT=8787
MODE=live                     # live | replay
RUN_FILE=runs/demo.jsonl
AGENT_MODE=claude             # claude | mock
SIM_SPEED=60
SIM_SEED=1022
ANTHROPIC_API_KEY=
MODEL_DISPATCH=claude-sonnet-5-5
MODEL_VOICE=claude-haiku-5-5
MODEL_DEGRADED=claude-haiku-5-5
BUDGET_CAP_USD=3.00
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=           # +1...
PHONE_T4_CARLOS=              # teammate playing Carlos (verified number)
PHONE_DISPATCHER_ANA=         # teammate playing Ana (verified number)
PUBLIC_BASE_URL=              # https://xxxx.trycloudflare.com  (tunnel to :8787)
VOICE_TRANSPORT=gather         # gather (Twilio speech, works on trial) | relay (ConversationRelay, paid accounts)
DRIVER_LANGUAGE=es-MX          # es-MX | en-US — language for LIVE driver calls (simulated stay Spanish)
LIVE_DRIVER_CALLS=request      # request: only hotkey C rings a real driver phone | all: the dispatcher's own calls ring too
GATHER_SPEECH_TIMEOUT=1        # seconds of silence that end a caller turn (1–5)
VITE_API_URL=http://localhost:8787
VITE_MOCK=0
WATCHDOG_NO_PROGRESS=on        # off for the demo: no planner pause / Ana call when the spike raises delay
