{
  "name": "linea",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w server",
    "start": "npm run start -w server",
    "mock": "AGENT_MODE=mock npm run start -w server",
    "replay": "npm run replay -w server",
    "web": "npm run dev -w web",
    "typecheck": "tsc --noEmit -p server && tsc --noEmit -p web",
    "routes": "tsx scripts/build-routes.ts",
    "demo:prep": "bash scripts/demo-prep.sh",
    "tunnel": "bash scripts/tunnel.sh"
  },
  "description": "Linea: an autonomous AI dispatcher for cross-border trucking at Otay Mesa",
  "license": "MIT"
}
